  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "keycloak-js": "26.2.2",
    "lowlight": "3.3.0",
    "mermaid": "12.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "24.19.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "storybook": "10.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
