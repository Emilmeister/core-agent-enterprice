{
  "name": "agent-ui-storybook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "storybook dev --host 127.0.0.1 -p 6007 --no-open --disable-telemetry",
