{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "react": [
        "node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "node_modules/@types/react-dom/*"
      ],
      "*": [
        "node_modules/*"
      ],
      "react-dom": [
        "node_modules/@types/react-dom"
      ],
      "keycloak-js": [
        "node_modules/keycloak-js/lib/keycloak.d.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "stories",
    ".storybook"
  ]
}
