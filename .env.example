# Copy to .env. Never commit the resulting file.
POSTGRES_DB=core_agent
POSTGRES_USER=core_agent
POSTGRES_PASSWORD=replace-with-a-long-random-password

MODEL_API_FORMAT=openai
# Optional provider label for Phoenix/OpenInference (auto-detected for OpenAI, Anthropic, MiniMax).
MODEL_PROVIDER=your-provider
MODEL_BASE_URL=https://api.example.com/v1
MODEL_NAME=your-model
MODEL_API_KEY=replace-with-provider-token

CORE_AGENT_NAME=core-agent
# Optional role/profile layer. The user request is sent separately; leave empty for no role prompt.
CORE_AGENT_PROFILE=
CORE_AGENT_PORT=8000
# Main is depth 0; allowed values are 0, 1, or the hard maximum 2.
CORE_AGENT_MAX_DEPTH=2
# with_terminal adds terminal/background command tools; Python is independent of this mode.
# without_terminal cannot be widened by CORE_AGENT_ALLOWED_BUILTIN_TOOLS.
CORE_AGENT_RUNTIME_MODE=with_terminal
# core.python.exec is exposed only when this is false. Risky nested calls remain denied.
LOCAL_APPROVAL_ENABLED=true
CORE_AGENT_APPROVAL_MODE=on_risk
LOCAL_WORKSPACE_ROOT=/tmp/core-agent/runs
DURABLE_STORAGE_ROOT=/data/durable
ARTIFACT_MAX_BYTES=50000000
# Narrow this comma-separated list to remove built-ins from both Agent Card and model catalog.
CORE_AGENT_ALLOWED_BUILTIN_TOOLS=core.terminal.exec,core.python.exec,core.task.start,core.task.get,core.task.list,core.task.wait,core.task.cancel,core.delegate,core.artifact.put,core.artifact.get
CORE_AGENT_PYTHON_MAX_CODE_CHARS=100000
CORE_AGENT_PYTHON_MAX_SECONDS=120
CORE_AGENT_PYTHON_MAX_OUTPUT_BYTES=1000000
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Production migration jobs may instead provide DATABASE_MIGRATION_URL and DATABASE_APP_ROLE.

# Local Compose starts Phoenix at this port and keeps traces for this many days.
PHOENIX_PORT=6006
PHOENIX_DEFAULT_RETENTION_POLICY_DAYS=30
# Development-only operator visibility in Phoenix: prompts, tool schemas/calls, and results.
# Production defaults to false unless an explicit redaction, access, sampling, and retention policy permits it.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
# Development-only structured stdout content. Production should set this to false.
CORE_AGENT_LOG_LEVEL=INFO
CORE_AGENT_LOG_CONTENT=true
CORE_AGENT_LOG_MAX_CHARS=12000

# Required only when the built-in production operator control plane is enabled.
# Generate an independent random value; do not reuse MODEL_API_KEY or database credentials.
OPERATOR_JWT_HS256_SECRET=replace-with-at-least-32-random-bytes
OPERATOR_JWT_ISSUER=https://operator.example
OPERATOR_JWT_AUDIENCE=core-agent-operator
OPERATOR_JWT_ROLE=agent_operator
LOCAL_APPROVAL_EXTENSION_URI=https://agent.example/a2a/extensions/local-operator-approval/v1

# Required in production. Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PUSH_NOTIFICATION_ENCRYPTION_KEY=replace-with-generated-fernet-key
