# Copy to .env. Never commit the resulting file.

# =============================================================================
# AGENT (A2A Agent Card and identity)
# =============================================================================
AGENT_NAME=core-agent
AGENT_DESCRIPTION=Policy-enforced core agent runtime
AGENT_VERSION=1.0.0
# Optional role/profile layer. The user request is sent separately; leave empty for no role prompt.
# It cannot replace the protected safety, host-policy or kernel layers.
AGENT_SYSTEM_PROMPT=
# Advertised base URL for the Agent Card; defaults to http://localhost:$PORT.
AGENT_URL=
# Synonym accepted by some hosting platforms; AGENT_URL wins if both are set.
URL_AGENT=
HOST=0.0.0.0
PORT=8000

# Explicit profile is required: production, development or test.
# Keycloak remains the default. Cloud.ru production requires PostgreSQL/S3,
# a stable encryption key, separate migrations and a working sandbox; see docs/cloudru-trial.md.
CORE_AGENT_ENVIRONMENT=development
# Authentication profile: keycloak (default) or explicit Cloud.ru proxy + owner cookie.
# Cloud.ru requires canonical HTTPS AGENT_URL (URL_AGENT is accepted), tenant,
# PostgreSQL even in development, and ingress reachable ONLY through the platform proxy.
# WORKSPACE_STORAGE_TYPE=s3 explicitly enables durable files; ARTIFACT_S3_*
# supplies fallback credentials only then. Platform ARTIFACT_STORAGE_*,
# ARTIFACT_MONGODB_* and RUNTIME_SAVE_INPUT_BLOBS_AS_ARTIFACTS do not enable storage.
CORE_AGENT_AUTH_MODE=keycloak
# Cloud.ru owner secret: 16..1024 characters; rotate on every replica together.
# A retired password cannot be activated again; stale replicas fail startup.
# Never put this value in frontend configuration or outgoing credentials.
CORE_AGENT_OWNER_PASSWORD=

# Optional local Keycloak in the same docker-compose.yml. Leave empty to use
# an external Keycloak or the anonymous development A2A profile.
# local-ui creates the realm and clients from .env on first startup; see LOCAL.md.
COMPOSE_PROFILES=
LOCAL_KEYCLOAK_USERNAME=admin
LOCAL_KEYCLOAK_ADMIN_PASSWORD=
# Initial owner credentials are read from .env by keycloak-init.
# Existing realm passwords are changed in Keycloak, not by editing .env.
LOCAL_OWNER_USERNAME=owner
LOCAL_OWNER_PASSWORD=

# =============================================================================
# KEYCLOAK (required together in keycloak auth mode; unused by cloudru)
# =============================================================================
# HTTPS realm issuer; loopback HTTP is allowed only in development/test.
KEYCLOAK_ISSUER_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Separate public browser client for Code Flow + PKCE S256; empty disables /ui/config.
KEYCLOAK_UI_CLIENT_ID=
KEYCLOAK_AUDIENCE=
KEYCLOAK_OWNER_ROLE=agent-owner
KEYCLOAK_EXTERNAL_ROLE=agent-external
# Fixed company scope; callers cannot choose or override it.
CORE_AGENT_TENANT_ID=

# =============================================================================
# LLM
# =============================================================================
LLM_API_FORMAT=openai
# Optional provider label for Phoenix/OpenInference (auto-detected for OpenAI, Anthropic, MiniMax).
LLM_PROVIDER=your-provider
LLM_API_BASE=https://api.example.com/v1
LLM_MODEL=your-model
LLM_API_KEY=replace-with-provider-token
LLM_MAX_TOKENS=4096
# Separate output limit for context summaries; capped by available request space.
LLM_SUMMARY_MAX_TOKENS=32768
LLM_CONTEXT_WINDOW=128000
LLM_TIMEOUT=120
# Blank keeps the provider default for each sampling knob.
LLM_TEMPERATURE=
LLM_TOP_P=
LLM_TOP_K=
LLM_FREQUENCY_PENALTY=
LLM_PRESENCE_PENALTY=

# THINKING_ENABLED=false sends an explicit "none" effort.
# THINKING_LEVEL: none, minimal, low, medium, high, xhigh, max; blank keeps provider default.
THINKING_ENABLED=true
THINKING_LEVEL=

# Separate detector context without tools. Leave all four blank to reuse the
# main model connection; an override requires all four, with no inherited headers.
# 'anthropic' uses Messages; other provider labels use OpenAI-compatible binding.
GUARDRAILS_LLM_PROVIDER=
GUARDRAILS_LLM_MODEL=
GUARDRAILS_LLM_BASE_URL=
GUARDRAILS_LLM_API_KEY=
GUARDRAILS_TIMEOUT_SECONDS=60
GUARDRAILS_MAX_INPUT_TOKENS=100000
GUARDRAILS_MAX_CALLS=32

# =============================================================================
# MCP
# =============================================================================
# Deployment defaults; authenticated owners can manage company connections in UI.
# Cloud.ru ignores MCP_URL/MCP_HEADERS_JSON; only persisted owner settings connect MCP.
# RunRequest contains only prompt and cannot add servers.
MCP_URL=
MCP_ALLOWED_SERVERS=
# Bare names allow a tool on any connected server; "server.tool" scopes it.
# Empty allows no MCP tool at all: every tool a run may call must be listed here.
MCP_ALLOWED_TOOLS=
# Unknown tools are mutating. List only operator-verified read-only tools here.
MCP_READ_ONLY_TOOLS=
MCP_HEADERS_JSON=
MCP_TIMEOUT=30.0
MCP_SSE_READ_TIMEOUT=300.0
# One total wait for all scale-to-zero MCP discovery in a run; 0 disables retries.
MCP_COLD_START_TIMEOUT_SECONDS=300.0

# =============================================================================
# LEGACY REMOTE A2A AGENTS (development/test without Keycloak)
# =============================================================================
# Authenticated mode uses the company registry from UI, not automatic ENV import.
# See core-agent-db import-remote-agents for an explicit one-time import.
REMOTE_AGENTS=
REMOTE_AGENTS_TIMEOUT=15.0
REMOTE_AGENTS_MAX_RETRIES=3
REMOTE_AGENTS_RETRY_DELAY=1.0
REMOTE_AGENTS_RETRY_BACKOFF=2.0
REMOTE_AGENTS_RETRYABLE_STATUS_CODES=500,502,503,504
# When set, downstream agents receive `Authorization: Api-Key <this>` instead of the caller's
# token. When empty the incoming Authorization is passed through unchanged.
SEND_MESSAGE_API_KEY=

# =============================================================================
# A2A CAPABILITIES AND STREAMING
# =============================================================================
# May only narrow what the runtime implements.
# Only streaming and push_notifications change the Agent Card; the other two are
# accepted for scheme compatibility.
A2A_CAPABILITIES=streaming,push_notifications,tool_calling,multi_turn
A2A_STREAMING_ENABLED=true
# Characters of growth before the next cumulative snapshot frame is emitted.
A2A_STREAMING_BUFFER_SIZE=10
# Encoded JSON/base64 HTTP body ceiling, independent of decoded owner file limit.
A2A_MAX_REQUEST_BYTES=40000000

# =============================================================================
# RUNTIME AND CAPABILITY CEILING
# =============================================================================
RUNTIME_MAX_LLM_CALLS=100
CORE_AGENT_MAX_TOOL_CALLS=200
# Maximum wait for owned Tasks to acknowledge cancellation before a truthful
# budget-exhausted partial result records them as still pending.
CORE_AGENT_BUDGET_CANCEL_GRACE_SECONDS=5
# Main is depth 0; allowed values are 0, 1, or the hard maximum 2.
CORE_AGENT_MAX_DEPTH=2
# with_terminal adds terminal/background command tools; Python is independent of this mode.
# without_terminal cannot be widened by CORE_AGENT_ALLOWED_BUILTIN_TOOLS.
CORE_AGENT_RUNTIME_MODE=with_terminal
LOCAL_WORKSPACE_ROOT=/tmp/core-agent/runs
# Docker Compose outer seccomp profile: amd64, or arm64 for Apple Silicon/native ARM.
# This selects the launch profile; it does not enable image emulation.
SANDBOX_OCI_ARCH=amd64
# Required in every serving profile. Requires native Linux namespaces, seccomp,
# Bubblewrap, slirp4netns and nftables; startup fails if preflight cannot run.
# Explicit landlock is available only with cloudru development/production; no automatic fallback.
SANDBOX_BACKEND=bubblewrap
SANDBOX_DNS_SERVERS=1.1.1.1,2606:4700:4700::1111
# Set the actual Pod/Service/node and protected internal ranges for deployment.
# Empty is invalid. Immutable special-purpose denies are always also applied.
SANDBOX_DENIED_CIDRS=
SANDBOX_START_TIMEOUT_SECONDS=10
SANDBOX_MAX_CONCURRENT_PROCESSES=4
SANDBOX_CPU_SECONDS=60
SANDBOX_ADDRESS_SPACE_BYTES=2147483648
SANDBOX_MAX_OPEN_FILES=256
SANDBOX_MAX_FILE_BYTES=104857600
# Persistent POSIX volume with Keycloak; Cloud.ru trial uses writable temporary RAM paths.
# Cloud.ru posix mode loses these bytes after Pod replacement; explicit s3 mode
# restores committed chat files and response artifacts from PostgreSQL + S3.
# Keep all three storage roots disjoint. Run snapshots never restore over chats.
CHAT_WORKSPACE_ROOT=/data/chats
DURABLE_STORAGE_ROOT=/data/durable
# Cloud.ru development may opt into s3; Cloud.ru production requires it.
# Both require PostgreSQL. No fallback if S3 fails.
WORKSPACE_STORAGE_TYPE=posix
# Blank connection fields use corresponding platform ARTIFACT_S3_* fields in s3 mode.
WORKSPACE_S3_ENDPOINT_URL=
WORKSPACE_S3_BUCKET=
WORKSPACE_S3_REGION=
WORKSPACE_S3_ACCESS_KEY_ID=
WORKSPACE_S3_SECRET_ACCESS_KEY=
WORKSPACE_S3_SESSION_TOKEN=
WORKSPACE_S3_PREFIX=core-agent
WORKSPACE_MAX_BYTES=100000000
WORKSPACE_MAX_FILES=10000
WORKSPACE_S3_MAX_INFLIGHT=4
# Blank uses the runtime mode ceiling; conditional tools still need their configured backends.
# Set a comma-separated subset to narrow both Agent Card and model catalog.
CORE_AGENT_ALLOWED_BUILTIN_TOOLS=
# Root planning defaults; owner UI can override/reset these for new tasks.
# Explicit built-in allowlist and owner policy still apply. Children do not plan.
CORE_AGENT_NEXT_STEPS=false
CORE_AGENT_NEXT_STEPS_EVERY=5
# The image contains these read-only packages; narrow the list to disable any of them.
SKILLS_ROOT=/opt/core-agent/skills
CORE_AGENT_ALLOWED_SKILLS=systematic-debugging,verification-before-completion,knowledge-synthesis,explore-data,validate-data,statistical-analysis,sql-queries
CORE_AGENT_PYTHON_MAX_CODE_CHARS=100000
CORE_AGENT_PYTHON_MAX_SECONDS=120
CORE_AGENT_TERMINAL_MAX_SECONDS=600
CORE_AGENT_PYTHON_MAX_OUTPUT_BYTES=1000000

# =============================================================================
# PLUGINS: ReflectAndRetry, EventsCompaction, ContextCache
# =============================================================================
REFLECT_AND_RETRY_ENABLED=true
REFLECT_AND_RETRY_MAX_RETRIES=3
EVENTS_COMPACTION_ENABLED=true
# 0 compacts only when the context budget threshold is reached.
EVENTS_COMPACTION_INTERVAL=0
EVENTS_COMPACTION_OVERLAP_SIZE=0
# Prompt caching is a request field on Anthropic; OpenAI-compatible providers cache the
# prefix automatically and ignore these values.
CONTEXT_CACHE_ENABLED=true
CONTEXT_CACHE_MIN_TOKENS=2048
CONTEXT_CACHE_TTL_SECONDS=600

# =============================================================================
# USER AND RESPONSE LIMITS
# =============================================================================
# Identity used when the A2A caller is unauthenticated.
USER_ID=anonymous
MAX_RESPONSE_SIZE=100000000
# 0 emits the result as a single artifact chunk.
MAX_CHUNK_SIZE=0

# =============================================================================
# STORAGE: session and task state
# =============================================================================
# Cloud.ru development/production require postgres for both; unavailable DB has no memory fallback.
# Production forbids DATABASE_AUTO_MIGRATE=true; separately migrate session and any distinct memory DB.
SESSION_STORAGE_TYPE=postgres
SESSION_POSTGRES_PROTOCOL=postgresql
SESSION_POSTGRES_USER=
SESSION_POSTGRES_PASSWORD=
SESSION_POSTGRES_HOST=
SESSION_POSTGRES_PORT=5432
SESSION_POSTGRES_DATABASE=
# A fully injected URL wins over the parts above; DATABASE_URL remains the fallback.
SESSION_DATABASE_URL=
# Durable background tasks require SESSION_STORAGE_TYPE=postgres.
TASK_STORAGE_TYPE=postgres
TASK_POSTGRES_URL=

# =============================================================================
# STORAGE: long-term memory
# =============================================================================
# optional publishes the core_memory_* tools when a backend is available; required
# fails startup without one; disabled removes them from Agent Card and model catalog.
CORE_AGENT_MEMORY=optional
# in-memory loses the corpus on restart and is refused in production or any Cloud.ru profile.
# Cloud.ru requires postgres when memory is enabled; disabled memory needs no backend.
MEMORY_STORAGE_TYPE=in-memory
# The shared DATABASE_URL pool is used unless MEMORY_POSTGRES_HOST gives memory its own DSN.
MEMORY_POSTGRES_PROTOCOL=postgresql
MEMORY_POSTGRES_USER=
MEMORY_POSTGRES_PASSWORD=
MEMORY_POSTGRES_HOST=
MEMORY_POSTGRES_PORT=5432
MEMORY_POSTGRES_DATABASE=
# Results returned by core_memory_search when the model passes no limit.
MEMORY_SEARCH_LIMIT=10
# The vector channel needs all three; without them search degrades to BM25 and graph.
# Falls back to LLM_API_BASE when empty. The key never falls back.
EMBEDDING_API_BASE=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=768
# Entity extraction runs on LLM_API_BASE/LLM_MODEL/LLM_API_KEY with a JSON
# schema; there is nothing to configure and nothing to point elsewhere.
# Bounds both the embedding and the extraction call.
MEMORY_PROVIDER_TIMEOUT_SECONDS=30

# =============================================================================
# LOCAL DATABASE (docker compose)
# =============================================================================
POSTGRES_DB=core_agent
POSTGRES_USER=core_agent
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Production migration jobs may instead provide DATABASE_MIGRATION_URL and DATABASE_APP_ROLE.

# =============================================================================
# OBSERVABILITY
# =============================================================================
# Local Compose starts Phoenix at this port and keeps traces for this many days.
PHOENIX_PORT=6006
PHOENIX_DEFAULT_RETENTION_POLICY_DAYS=30
# Base OTLP endpoint; the per-signal OTEL_EXPORTER_OTLP_*_ENDPOINT variables take priority.
# A base endpoint derives ONLY /v1/traces. Metrics and logs need their own
# per-signal variables. ENABLE_OTEL=false switches export off entirely.
ENABLE_OTEL=true
OTEL_PROJECT_NAME=
OTEL_ENDPOINT=
# Explicit OTLP/Phoenix key uses Authorization: Bearer. When absent, Cloud.ru's
# injected OTEL_ENDPOINT_API_KEY uses Authorization: Api-Key instead.
OTEL_API_KEY=
OTEL_SERVICE_NAME=core-agent
# Development-only operator visibility in Phoenix: prompts, tool schemas/calls, and results.
# Production defaults to false unless an explicit redaction, access, sampling, and retention policy permits it.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
# Development-only structured stdout content. Production should set this to false.
LOG_LEVEL=INFO
# Set true for the Cloud.ru trial: bounded stages/platform facts, never ENV values/secrets.
# application_ready means ASGI construction; Uvicorn/probes confirm the actual listener.
CORE_AGENT_STARTUP_DIAGNOSTICS=false
# For logs sent from the trial set both content-capture switches above/below to false.
CORE_AGENT_LOG_CONTENT=true
CORE_AGENT_LOG_MAX_CHARS=12000
# Added as the X-Internal-Entity-ID header on outgoing provider, MCP, and memory provider calls.
ENTITY_ID=

# Required in production. Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PUSH_NOTIFICATION_ENCRYPTION_KEY=replace-with-generated-fernet-key
