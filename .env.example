# Copy to .env. Never commit the resulting file.
POSTGRES_DB=core_agent
POSTGRES_USER=core_agent
POSTGRES_PASSWORD=replace-with-a-long-random-password

MODEL_API_FORMAT=openai
MODEL_BASE_URL=https://api.example.com/v1
MODEL_NAME=your-model
MODEL_API_KEY=replace-with-provider-token

CORE_AGENT_PORT=8000
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Production migration jobs may instead provide DATABASE_MIGRATION_URL and DATABASE_APP_ROLE.

# Required by the built-in production operator control plane.
# Generate an independent random value; do not reuse MODEL_API_KEY or database credentials.
OPERATOR_JWT_HS256_SECRET=replace-with-at-least-32-random-bytes
OPERATOR_JWT_ISSUER=https://operator.example
OPERATOR_JWT_AUDIENCE=core-agent-operator
OPERATOR_JWT_ROLE=agent_operator
LOCAL_APPROVAL_EXTENSION_URI=https://agent.example/a2a/extensions/local-operator-approval/v1

# Required in production. Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PUSH_NOTIFICATION_ENCRYPTION_KEY=replace-with-generated-fernet-key
